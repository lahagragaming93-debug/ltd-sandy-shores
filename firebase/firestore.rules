rules_version = '2';

// ============================================================
// Règles Firestore — LTD Sandy Shores
// ============================================================
// Principes :
//  - Toute lecture/écriture nécessite une authentification.
//  - Le profil utilisateur (collection /users) porte le rôle.
//  - Les écritures sensibles (config, prix, comptes) sont
//    restreintes au Patron / Co-Patron.
//  - Le bot Discord écrit via le SDK Admin (ignore les rules).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // === Helpers ===
    function isAuth() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function statut() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.statut;
    }
    function isActif()       { return statut() == 'actif'; }
    function isDirection()   { return role() == 'patron' || role() == 'co-patron'; }
    function isDRH()         { return role() == 'drh'; }
    function isRespVente()   { return role() == 'responsable-vente'; }
    function isRespPompiste(){ return role() == 'responsable-pompiste'; }
    function isResponsable() { return isRespVente() || isRespPompiste(); }

    // Hiérarchie de gestion : currentRole peut-il agir sur targetRole ?
    //   Patron : tout
    //   Co-Patron : tout sauf Patron
    //   DRH : tout sauf Patron, Co-Patron (peut gérer un autre DRH)
    //   Resp Vente : uniquement vendeur-*
    //   Resp Pompiste : uniquement pompiste-*
    function canManage(currentRole, targetRole) {
      return currentRole == 'patron'
        || (currentRole == 'co-patron' && targetRole != 'patron')
        || (currentRole == 'drh' && targetRole != 'patron' && targetRole != 'co-patron')
        || (currentRole == 'responsable-vente'    && targetRole.matches('vendeur-.*'))
        || (currentRole == 'responsable-pompiste' && targetRole.matches('pompiste-.*'));
    }

    // === Users ===
    // Lecture : soi-même, direction, DRH, responsables (pour filtres ventes/RH).
    // Vendeurs et pompistes ne peuvent lire QUE leur propre profil.
    match /users/{uid} {
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        isDirection() || isDRH() || isResponsable()
      );
      // Création : le créateur doit pouvoir gérer le rôle créé
      // (Direction, DRH, Responsables — selon hiérarchie canManage).
      allow create: if isAuth() && canManage(role(), request.resource.data.role);
      // Update :
      //  - Soi-même peut maj ses propres infos (mais pas son rôle ni son statut)
      //  - Sinon : le rôle ACTUEL et le NOUVEAU rôle doivent tous deux être dans
      //    le périmètre de gestion du créateur (évite l'élévation hors périmètre)
      allow update: if isAuth() && (
        (request.auth.uid == uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.statut == resource.data.statut) ||
        (canManage(role(), resource.data.role) &&
         canManage(role(), request.resource.data.role))
      );
      // Delete : le rôle de la cible doit être dans mon périmètre
      allow delete: if isAuth() && canManage(role(), resource.data.role);
    }

    // === Produits ===
    // Lecture : tout employé actif
    // Création / suppression d'un produit : direction + DRH uniquement (gestion catalogue)
    // Modification des champs (prix, seuil…) : direction + DRH + Resp Vente (gestion quotidienne)
    match /produits/{id} {
      allow read:   if isAuth() && isActif();
      allow create: if isDirection() || isDRH();
      allow update: if isDirection() || isDRH() || isRespVente();
      allow delete: if isDirection() || isDRH();
    }

    // === Historique des prix (audit trail, append-only) ===
    match /historiquePrix/{id} {
      allow read:   if isDirection() || isDRH();
      allow create: if isDirection() || isDRH() || isRespVente();
      allow update, delete: if false;
    }

    // === Stocks ===
    match /stocks/{id} {
      allow read:  if isAuth() && isActif();
      // Écriture humaine : direction + responsable vente
      // (le bot Discord passe par Admin SDK et n'est pas concerné)
      allow write: if isDirection() || isRespVente();
    }

    // === Mouvements de stock (append-only depuis l'app) ===
    match /mouvementsStock/{id} {
      allow read:   if isAuth() && isActif();
      allow create: if isDirection() || isRespVente();
      allow update, delete: if isDirection();
    }

    // === Ventes ===
    match /ventes/{id} {
      allow read:   if isAuth() && isActif();
      allow create: if isDirection();      // saisie manuelle exceptionnelle
      allow update, delete: if isDirection();
    }

    // === Stations essence ===
    match /stations/{id} {
      allow read:  if isAuth() && isActif();
      allow write: if isDirection() || isRespPompiste();
    }
    match /redistributions/{id} {
      allow read:   if isAuth() && isActif();
      allow create: if isDirection() || isRespPompiste();
      allow update, delete: if isDirection();
    }

    // === Services / quotas pompistes ===
    match /services/{id}        { allow read: if isAuth() && isActif();
                                  allow write: if isDirection(); }
    match /quotasPompiste/{id}  { allow read: if isAuth() && isActif();
                                  allow write: if isDirection(); }

    // === Dépenses ===
    match /depenses/{id} {
      allow read:   if isAuth() && (isDirection() || isDRH());
      allow create: if isDirection();
      allow update, delete: if isDirection();
    }

    // === Paies ===
    // Direction/DRH lisent tout. L'employé peut lire SES paies (filtre obligatoire
    // côté client : where('beneficiaireId', '==', request.auth.uid)).
    match /paies/{id} {
      allow read:  if isAuth() && isActif() && (
        isDirection() || isDRH() ||
        resource.data.beneficiaireId == request.auth.uid
      );
      allow write: if isDirection();
    }

    // === Semaines (clôtures) ===
    match /semaines/{id} {
      allow read:  if isAuth() && (isDirection() || isDRH());
      allow write: if isDirection();    // les Functions utilisent l'admin SDK
    }

    // === Alertes ===
    match /alertes/{id} {
      allow read:   if isAuth() && isActif();
      allow create: if isDirection();
      allow update: if isDirection() || isDRH() || isResponsable();
      allow delete: if isDirection();
    }

    // === Configuration globale ===
    // /config/main : config publique aux utilisateurs actifs (quotas, prix essence, etc.)
    // /config/secrets : tokens et secrets sensibles, direction uniquement
    match /config/secrets {
      allow read, write: if isDirection();
    }
    match /config/{id} {
      allow read:  if isAuth() && isActif();
      allow write: if isDirection();
    }

    // === Logs bruts (canaux divers) — lecture direction uniquement ===
    match /logsBruts/{id} {
      allow read:  if isDirection();
      allow write: if false;             // écrit uniquement par bot/Functions
    }
  }
}
